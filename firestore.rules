rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Profiles Collection
    // Schema:
    // - profileId: string (immutable)
    // - nickname: string (max 20 chars, optional)
    // - currentLevel: number (1-3, server-managed)
    // - preferences: map
    // - progressSummary: map (server-managed)
    // - createdAt: timestamp
    // - updatedAt: timestamp
    match /profiles/{profileId} {
      // Parents / owners can read their child profile
      allow read: if isOwner(profileId);

      // Clients cannot write or manipulate progress/level directly.
      // All scoring, level progression, and stars must pass through Next.js server Route Handlers.
      // Client writes are disallowed; server uses Firebase Admin SDK or authenticated server handlers.
      allow create, update: if false;

      // Parents can delete their child's data for privacy/COPPA compliance
      allow delete: if isOwner(profileId);

      // Activities Subcollection
      // profiles/{profileId}/activities/{activityId}
      match /activities/{activityId} {
        allow read: if isOwner(profileId);
        allow write: if false; // Only server can write activity scores
      }

      // Sessions Subcollection
      // profiles/{profileId}/sessions/{sessionId}
      match /sessions/{sessionId} {
        allow read: if isOwner(profileId);
        allow write: if false; // Only server can write session state
      }
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
