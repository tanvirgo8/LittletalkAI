# ============================================================
# LittleTalk AI - Environment Configuration Template
# Copy this file to .env.local to configure persistent Firebase or LLM
# NOTE: The application runs 100% in Demo Mode without any of these!
# ============================================================

# ─── Firebase Firestore Persistence (Optional) ───────────────
# If omitted or set to demo-project, in-memory demo storage will be used.
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-firebase-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-app.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-firebase-app-id"

# ─── Optional LLM Integration (Disabled by Default) ─────────
# When ENABLE_LLM is false, the deterministic rule engine handles all chats (< 2ms)
ENABLE_LLM="false"
LLM_PROVIDER="openai" # options: openai, gemini, anthropic
LLM_API_KEY="your-api-key"
LLM_MODEL="gpt-4o-mini"
LLM_ENDPOINT="https://api.openai.com/v1/chat/completions"

# ─── Application Settings ───────────────────────────────────
NODE_ENV="development"
